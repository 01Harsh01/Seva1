# ============================================================
# HomeSync — environment variables
# The current build runs entirely client-side with localStorage
# as a demo data store, so NOTHING here is required to run or
# deploy the demo. These are placeholders for the production
# integrations described in the README.
# ============================================================

# Payments — Razorpay (India). NEVER put the key secret in
# frontend code. Only VITE_/NEXT_PUBLIC_-style *public* key IDs
# belong client-side; the secret stays in a backend/serverless
# function that creates orders and verifies signatures.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: swap the local demo store for a real database later
# (Firestore, Postgres, etc.) — see js/store.js for the functions
# to re-implement against a real backend.
DATABASE_URL=
